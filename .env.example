OPENAI_API_KEY=
PLAGUESHIELD_LLM_MODEL=gpt-5.5
PLAGUESHIELD_WORKER_ENABLED=true
PLAGUESHIELD_RUN_INTERVAL_SECONDS=120
PLAGUESHIELD_LIVE_EVIDENCE=true
# PLAGUESHIELD_TOKEN_ADDRESS=
# PLAGUESHIELD_TOKEN_SYMBOL=PLAGUESHIELD
# PLAGUESHIELD_TOKEN_MARKET_CAP=

# X user credentials: app must have Read and Write permissions.
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
PLAGUESHIELD_X_ACCOUNT=plagueshieldX
PLAGUESHIELD_X_ENABLED=false
PLAGUESHIELD_X_DRY_RUN=true
PLAGUESHIELD_X_INTERVAL_SECONDS=300
# Required for live posting: your public HTTPS website, not localhost.
PLAGUESHIELD_PUBLIC_URL=

# Production: persistent volume location and read-only public API.
# PLAGUESHIELD_DATA_DIR=/data
# PLAGUESHIELD_PUBLIC_READ_ONLY=true
